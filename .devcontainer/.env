# Common
TZ='Asia/Seoul'
ENV='dev'
ROOT_PATH='/'
LOGGING__LEVEL='INFO'
TOKEN_URL='token'

# LLM Wiki
WIKI_PATH='/workspaces/fastapi-core/wiki'

# keycloak
# KEYCLOAK__HTTP_URL='http://keycloak:8080/'
# KEYCLOAK__MANAGE_URL='http://keycloak:9000/'
# KEYCLOAK__REALM='restapi'
# KEYCLOAK__CLIENT_ID='fastapi'

KEYCLOAK_URL='http://keycloak:8080'
KEYCLOAK_REALM='restapi'
KEYCLOAK_CLIENT_ID='fastapi'
KEYCLOAK_VERIFY_SSL=false
KEYCLOAK_TOKEN_GRANT_TYPE=password
KEYCLOAK_TOKEN_USERNAME='test'
KEYCLOAK_TOKEN_PASSWORD='test'

# CORS
CORS__ORIGINS='*'
CORS__CREDENTIALS=false

# auth
AUTH__VERIFY_JWT=false

# PostgreSQL
DB__HOST='postgres'
DB__PORT=5432
DB__NAME='postgres'
DB__USER='postgres'
DB__PASSWORD='postgres'
DB__AUTH_METHOD='password'
DB__SSLMODE='prefer'
DB__CONNECT_TIMEOUT=5
DB__ECHO=false
# DB__URL='postgresql+psycopg://postgres:postgres@localhost:5432/postgres'

# MinIO
MINIO__ENDPOINT='minio:9000'
MINIO__ACCESS_KEY='admin'
MINIO__SECRET_KEY='password'
MINIO__SECURE=false
MINIO__BUCKET='default'

# Hermes Agent
HERMES_HOME="/workspaces/fastapi-core/.hermes"

# NATS
NATS__SERVERS='nats://nats:4222'
NATS__NAME='fastapi-core'
NATS__CONNECT_TIMEOUT=2
NATS__MAX_RECONNECT_ATTEMPTS=60
NATS__RECONNECT_TIME_WAIT_MS=2000
NATS__QUEUE_GROUP='fastapi-workers'

# Ollama
OLLAMA__HOST=http://ollama:11434
OLLAMA__MODEL=llama3.2
OLLAMA__TIMEOUT=60.0

# Milvus
MILVUS__URI=http://milvus:19530
MILVUS__DB_NAME=''
MILVUS__TOKEN=''
MILVUS__TIMEOUT=10

# Langfuse
LANGFUSE__HOST=http://langfuse-web:3000
LANGFUSE__PUBLIC_KEY=pk-lf-bc3df356-ce5b-46e4-963e-1e2142b77117
LANGFUSE__SECRET_KEY=sk-lf-d8407485-bed9-4d2a-ab13-bc694a6b5a2a
LANGFUSE__TIMEOUT=5
LANGFUSE__TRACING_ENABLED=true
LANGFUSE__ENVIRONMENT=
LANGFUSE__RELEASE=
