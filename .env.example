# fastapi-core environment example
#
# This file includes:
# - FastAPI app assembly environment variables used directly by fastapi-core
# - full docmesh_py_core Settings surface used by load_settings(...)
#
# Copy to `.env` and replace placeholders for your environment.
# Do not use these development placeholders in production.

# -----------------------------------------------------------------------------
# FastAPI app assembly
# -----------------------------------------------------------------------------
ROOT_PATH=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_CREDENTIALS=false
READINESS_PARALLEL=false

# -----------------------------------------------------------------------------
# Common docmesh settings
# -----------------------------------------------------------------------------
DOCMESH_ENV=development
DOCMESH_HEALTHCHECK_ENABLED=true

# -----------------------------------------------------------------------------
# Auth / Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_URL=http://keycloak.local
KEYCLOAK_REALM=docmesh
KEYCLOAK_CLIENT_ID=fastapi-core
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_VERIFY_SSL=true
# Optional audience validation target
# KEYCLOAK_AUDIENCE=fastapi-core

# Token acquisition
KEYCLOAK_TOKEN_GRANT_TYPE=client_credentials
# KEYCLOAK_TOKEN_SCOPE=openid profile email
# Required when KEYCLOAK_TOKEN_GRANT_TYPE=password
# KEYCLOAK_TOKEN_USERNAME=service-account-user
# KEYCLOAK_TOKEN_PASSWORD=change-me
KEYCLOAK_REQUEST_TIMEOUT_SECONDS=10
KEYCLOAK_MAX_RETRIES=3
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=300

# Optional provisioning / realm bootstrap
KEYCLOAK_PROVISIONING_ENABLED=false
KEYCLOAK_PROVISIONING_DRY_RUN=false
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
# Choose exactly one admin auth mode when provisioning is enabled:
# 1) service-account mode
# KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
# 2) username/password mode
# KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_REALM_ENABLED=true
# KEYCLOAK_REALM_DISPLAY_NAME=DocMesh
KEYCLOAK_CLIENT_PUBLIC=false
# CSV lists
# KEYCLOAK_CLIENT_REDIRECT_URIS=http://localhost:3000/*,https://app.example.com/*
# KEYCLOAK_CLIENT_WEB_ORIGINS=http://localhost:3000,https://app.example.com
# KEYCLOAK_REALM_ROLES=admin,operator,user
# KEYCLOAK_CLIENT_ROLES=reader,writer

# -----------------------------------------------------------------------------
# Database (choose PostgreSQL and/or SQLite as needed by your deployment)
# Postgres is optional, but if you set it then provide either POSTGRES_DSN
# or the host/db/user/password tuple.
# -----------------------------------------------------------------------------
# POSTGRES_DSN=postgresql+psycopg://user:password@postgres.local:5432/docmesh
# POSTGRES_HOST=postgres.local
# POSTGRES_PORT=5432
# POSTGRES_DB=docmesh
# POSTGRES_USER=docmesh
# POSTGRES_PASSWORD=change-me
# POSTGRES_SSLMODE=prefer
# POSTGRES_CONNECT_TIMEOUT_SECONDS=10
# POSTGRES_POOL_SIZE=5
# POSTGRES_MAX_OVERFLOW=10

SQLITE_PATH=:memory:
SQLITE_READONLY=false
SQLITE_ENABLE_WAL=false
SQLITE_BUSY_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Object storage / vector DB
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio.local:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=change-me
MINIO_SECURE=true
# MINIO_REGION=ap-northeast-2
# MINIO_BUCKET=docmesh
MINIO_REQUEST_TIMEOUT_SECONDS=30
MINIO_MAX_RETRIES=3

MILVUS_URI=http://milvus.local:19530
# MILVUS_TOKEN=change-me
MILVUS_DB_NAME=default
# MILVUS_COLLECTION=documents
MILVUS_SECURE=false
MILVUS_CONNECT_TIMEOUT_SECONDS=10
MILVUS_REQUEST_TIMEOUT_SECONDS=30
MILVUS_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# LLM / observability / messaging
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://ollama.local:11434
# OLLAMA_GENERATION_MODEL=llama3.1:8b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=2

LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://langfuse.local:3000
LANGFUSE_PUBLIC_KEY=change-me
LANGFUSE_SECRET_KEY=change-me
# LANGFUSE_RELEASE=fastapi-core@0.1.5
LANGFUSE_ENVIRONMENT=development
LANGFUSE_REQUEST_TIMEOUT_SECONDS=10
LANGFUSE_MAX_RETRIES=3

NATS_SERVERS=nats://nats.local:4222
# Choose exactly one authentication mode:
# 1) user/password
# NATS_USER=docmesh
# NATS_PASSWORD=change-me
# 2) token
NATS_TOKEN=change-me
# 3) creds file
# NATS_CREDS_FILE=/run/secrets/nats.creds
NATS_NAME=docmesh-py-core
NATS_CONNECT_TIMEOUT_SECONDS=10
NATS_MAX_RECONNECT_ATTEMPTS=10
