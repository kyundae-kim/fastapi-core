# fastapi-core example environment
# The library reads process environment variables; it does not load this file.
# Keep real secrets outside version control.
# Configuration contract: docs/config.md
# GitHub Wiki snapshot: https://github.com/kyundae-kim/fastapi-core/wiki/Configuration-v0.7.0
# Active lines form a service-free baseline. Uncomment one complete service block
# only after adding that service to DOCMESH_SERVICES.
# To enable a service, edit the active DOCMESH_SERVICES and READINESS_REQUIRED_SERVICES
# lines below. Required services must be included in DOCMESH_SERVICES.
# Keep both lines empty for a service-free smoke test; removing them restores model defaults.

# FastAPI application (CFG-APP)
ROOT_PATH=
TOKEN_URL=/token
CORS_ORIGINS=*
CORS_CREDENTIALS=false
READINESS_PARALLEL=false
# READINESS_TIMEOUT_SECONDS=5
# READINESS_OVERALL_TIMEOUT_SECONDS=30
DOCMESH_SERVICE_ALTERNATIVES=
DOCMESH_HEALTHCHECK_ENABLED=false
DOCMESH_STARTUP_FAILURE_MODE=fail
DOCMESH_STARTUP_HEALTHCHECK_ATTEMPTS=1
DOCMESH_STARTUP_HEALTHCHECK_RETRY_DELAY_SECONDS=0
DOCMESH_LOG_LEVEL=WARNING
APP_LOG_PATH=
APP_LOG_JSON=true
APP_LOG_FORCE=false
ACCESS_LOG_ENABLED=true
ACCESS_LOG_HEALTH_ENABLED=false
DOCMESH_SERVICES=
READINESS_REQUIRED_SERVICES=

# DocMesh common service settings
DOCMESH_ENV=development
DOCMESH_SECURITY_MODE=
DOCMESH_PRODUCTION_ALIASES=prod,production

# Keycloak (select with DOCMESH_SERVICES=keycloak)
# Required: URL, realm, client ID, and normally client secret.
# KEYCLOAK_URL=https://keycloak.example.com
# KEYCLOAK_REALM=docmesh
# KEYCLOAK_CLIENT_ID=docmesh-backend
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_VERIFY_SSL=true
# KEYCLOAK_AUDIENCE=
# KEYCLOAK_TOKEN_GRANT_TYPE=password
# KEYCLOAK_TOKEN_SCOPE=
# KEYCLOAK_TOKEN_USERNAME=
# KEYCLOAK_TOKEN_PASSWORD=
# KEYCLOAK_REQUEST_TIMEOUT_SECONDS=10
# KEYCLOAK_MAX_RETRIES=3
# KEYCLOAK_JWKS_CACHE_TTL_SECONDS=300
# KEYCLOAK_PROVISIONING_ENABLED=false
# KEYCLOAK_PROVISIONING_DRY_RUN=false
# KEYCLOAK_ADMIN_REALM=master
# KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
# KEYCLOAK_ADMIN_CLIENT_SECRET=
# KEYCLOAK_ADMIN_USERNAME=
# KEYCLOAK_ADMIN_PASSWORD=
# KEYCLOAK_REALM_ENABLED=true
# KEYCLOAK_REALM_DISPLAY_NAME=
# KEYCLOAK_CLIENT_PUBLIC=false
# KEYCLOAK_CLIENT_REDIRECT_URIS=
# KEYCLOAK_CLIENT_WEB_ORIGINS=
# KEYCLOAK_REALM_ROLES=
# KEYCLOAK_CLIENT_ROLES=

# PostgreSQL (select with DOCMESH_SERVICES=postgres)
# Required: host, database, user, and password. Use the individual fields below.
# POSTGRES_HOST=postgres.example.com
# POSTGRES_PORT=5432
# POSTGRES_DB=docmesh
# POSTGRES_USER=docmesh
# POSTGRES_PASSWORD=
# POSTGRES_SSLMODE=prefer
# POSTGRES_CONNECT_TIMEOUT_SECONDS=10
# POSTGRES_POOL_SIZE=5
# POSTGRES_MAX_OVERFLOW=10
# POSTGRES_POOL_PRE_PING=false
# POSTGRES_POOL_RECYCLE_SECONDS=-1
# POSTGRES_ECHO=false
# POSTGRES_APPLICATION_NAME=

# SQLite (select with DOCMESH_SERVICES=sqlite)
# Required: SQLITE_PATH. Use :memory: for a local smoke test.
# SQLITE_PATH=:memory:
# SQLITE_READONLY=false
# SQLITE_ENABLE_WAL=false
# SQLITE_BUSY_TIMEOUT_MS=5000
# SQLITE_CHECK_SAME_THREAD=false
# SQLITE_ECHO=false

# MinIO (select with DOCMESH_SERVICES=minio)
# Required: endpoint, access key, and secret key.
# MINIO_ENDPOINT=minio.example.com:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_SECURE=true
# MINIO_CERT_CHECK=true
# MINIO_REGION=
# MINIO_BUCKET=
# MINIO_REQUEST_TIMEOUT_SECONDS=30
# MINIO_MAX_RETRIES=3

# Milvus (select with DOCMESH_SERVICES=milvus)
# Required: MILVUS_ENDPOINT. Production also requires MILVUS_SECURE=true.
# MILVUS_ENDPOINT=http://milvus.example.com:19530
# MILVUS_TOKEN=
# MILVUS_DB_NAME=default
# MILVUS_COLLECTION=
# MILVUS_SECURE=false
# MILVUS_CONNECT_TIMEOUT_SECONDS=10
# MILVUS_REQUEST_TIMEOUT_SECONDS=30
# MILVUS_MAX_RETRIES=3

# Ollama (select with DOCMESH_SERVICES=ollama)
# Required: OLLAMA_HOST.
# OLLAMA_HOST=http://ollama.example.com:11434
# OLLAMA_VERIFY_SSL=true
# OLLAMA_FOLLOW_REDIRECTS=true
# OLLAMA_GENERATION_MODEL=
# OLLAMA_EMBEDDING_MODEL=
# OLLAMA_REQUEST_TIMEOUT_SECONDS=120
# OLLAMA_MAX_RETRIES=2

# Langfuse (select with DOCMESH_SERVICES=langfuse)
# Enabled mode requires host, public key, and secret key.
# LANGFUSE_ENABLED=true
# LANGFUSE_HOST=https://langfuse.example.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_RELEASE=
# LANGFUSE_ENVIRONMENT=
# LANGFUSE_REQUEST_TIMEOUT_SECONDS=10
# LANGFUSE_MAX_RETRIES=3
# LANGFUSE_DEBUG=false
# LANGFUSE_TRACING_ENABLED=true
# LANGFUSE_FLUSH_AT=
# LANGFUSE_FLUSH_INTERVAL_SECONDS=
# LANGFUSE_SAMPLE_RATE=

# NATS (select with DOCMESH_SERVICES=nats)
# Required: NATS_SERVERS. Choose at most one auth mode.
# NATS_SERVERS=nats://nats.example.com:4222
# NATS_USER=
# NATS_PASSWORD=
# NATS_TOKEN=
# NATS_CREDS_FILE=
# NATS_NAME=docmesh-py-core
# NATS_CONNECT_TIMEOUT_SECONDS=10
# NATS_MAX_RECONNECT_ATTEMPTS=10
# NATS_RECONNECT_TIME_WAIT_SECONDS=2.0
# NATS_PING_INTERVAL_SECONDS=120
# NATS_MAX_OUTSTANDING_PINGS=2
# NATS_NO_ECHO=false
